{
  "name": "handshake_mismatch",
  "description": "The host asks for a kind_api the worker does not serve. The worker sends no hello_ack and exits with status 78, which the host reads as contract not served.",
  "kind": "frames",
  "expect": {
    "worker_frames": [],
    "exit_code": 78
  },
  "frames": [
    {
      "from": "host",
      "frame": {
        "t": "hello",
        "op": "",
        "protocol": 1,
        "kind_api": "other.v9",
        "host_version": "1.0.0",
        "limits": {
          "control_frame_bytes": 65536,
          "chunk_bytes": 1048576,
          "request_body_bytes": 16777216,
          "result_body_bytes": 16777216,
          "result_floor_bytes": 1048576,
          "result_factor": 4,
          "checkpoint_bytes": 8388608
        },
        "heartbeat_interval": 10,
        "max_in_flight": 1,
        "folders": {
          "data_dir": "/srv/plugin/data",
          "temp_dir": "/srv/plugin/tmp",
          "artifacts_dir": "/srv/plugin/artifacts"
        }
      }
    }
  ]
}
